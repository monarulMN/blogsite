@model UpdateBlogSiteModel;

@{
    ViewData["Title"] = "Blog site update";
}

@section Style {
    <link href="https://cdn.jsdelivr.net/npm/summernote@0.9.0/dist/summernote-lite.min.css" rel="stylesheet">
}

<h5 class="fw-bold py-3 mb-4"><span class="text-muted fw-light">Blog site / </span>Blog site update view</h5>

<div class="row">
    <div class="col-xl">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Update blog site form</h5>
            </div>
            <div class="card-body">
                <partial name="_ResponsePartial" />

                <form asp-antiforgery="true" asp-area="Admin" asp-controller="BlogSite"
                      asp-action="Update">
                    <input type="hidden" asp-for="Id" />
                 
                    <div class="mb-3">
                        <label class="form-label" asp-for="Name"></label>
                        <div class="input-group input-group-merge">
                            <input type="text"
                                   asp-for="Name"
                                   class="form-control"
                                   placeholder="blog site name"
                                   aria-label="Name"
                                   aria-describedby="blog site name" />
                        </div>
                        <div asp-for="Title" class="form-text">
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" asp-for="Description"></label>
                        <div class="input-group input-group-merge">
                            <textarea type="text"
                                   asp-for="Description"
                                   class="form-control"
                                   placeholder="blog site description"
                                   aria-label="Name"
                                   aria-describedby="blog site description">
                            </textarea>
                        </div>
                        <div asp-for="Title" class="form-text">
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary btn-sm ">update</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
