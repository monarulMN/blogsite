@model IEnumerable<RoleWithUserCountViewModel>
@{
    ViewData["Title"] = "Role list";
}

@section Style {
    <link rel="stylesheet" href="https://cdn.datatables.net/2.3.5/css/dataTables.dataTables.css" />
}

<h5 class="fw-bold py-3 mb-4"><span class="text-muted fw-light">User Management /</span> Role list view</h5>

<div class="row">
    <div class="card">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div class="card-title mb-1">
                <h5>List view</h5>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive text-nowrap">
                <table class="table table-striped table-sm text-center">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Assigned User</th>
                        </tr>
                    </thead>
                    <tbody class="table-border-bottom-0">
                        @foreach (var role in Model)
                        {
                            <tr>
                                <td>@role.RoleName </td>
                                <td><span class="badge bg-info">@role.UserCount</span></td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th>Name</th>
                            <th>Assigned User</th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>
