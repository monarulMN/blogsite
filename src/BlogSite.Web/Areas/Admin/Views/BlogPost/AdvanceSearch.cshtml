@model BlogPostListModel
@{
    ViewData["Title"] = "BlogPost advance search";
}
@section Style {
    <link rel="stylesheet" href="https://cdn.datatables.net/2.3.5/css/dataTables.dataTables.css" />
}

<h5 class="fw-bold py-3 mb-4"><span class="text-muted fw-light">BlogPost / </span>BlogPost advance search</h5>

<div class="row">
    <div class="card">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div class="card-title mb-1">
                <h5>Advance search list view</h5>
            </div>
        </div>
        <div class="card-body">
            <div class="card">
                <div class="card-header">
                    <div class="card-title">Advance search inputs</div>
                </div>

                <div class="card-body">
                    <div class="row">
                        <div class="col">
                            <input type="text" asp-for="SearchItem.Title" class="form-control form-control-sm" placeholder="Title">
                        </div>
                        <div class="col">
                            <input type="datetime-local" asp-for="SearchItem.DateFrom" class="form-control form-control-sm">
                        </div>

                        <div class="col">
                            <input type="datetime-local" asp-for="SearchItem.DateTo" class="form-control form-control-sm">
                        </div>

                        <div class="col">
                            <button type="submit" class="btn btn-sm btn-outline-primary w-100" id="search">
                                <i class='fa fa-search-plus'></i> search
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            <partial name="_ResponsePartial" />
            <div class="table-responsive text-nowrap">
                <table class="table table-striped table-sm" id="blogPosts">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Body</th>
                            <th>Created At</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody class="table-border-bottom-0"></tbody>
                    <tfoot>
                        <tr>
                            <th>Title</th>
                            <th>Body</th>
                            <th>Created At</th>
                            <th>Action</th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>

<partial name="_DeleteCanvasPartial" />

<div class="modal fade" id="blog-preview-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-fullscreen" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalFullTitle">Blog Preview</h5>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="blog-data"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-outline-danger" data-bs-dismiss="modal">
                    Close
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/2.3.5/js/dataTables.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/editorjs-html@3.4.0/build/edjsHTML.browser.min.js"></script>
    <script>
         $(function(){
             $("#blogPosts").DataTable({
                 processing: true,
                 serverSide: true,
                 responsive: true,
                 lengthChange: true,
                 autoWidth: false,
                 searching: false,
                 ajax:{
                     url:'/Admin/BlogPost/GetBlogsDataAdvanceSearch',
                     type:'post',
                     contentType:'application/json',
                     dataType:'json',
                     data: function(d){
                         d.searchItem = {
                             Title : $("#SearchItem_Title").val(),
                             DateFrom : $("#SearchItem_DateFrom").val() === "" ? null : $("#SearchItem_DateFrom").val(),
                             DateTo : $("#SearchItem_DateTo").val() === "" ? null : $("#SearchItem_DateTo").val()
                         };

                         return JSON.stringify(d);
                     }
                 },
                 columnDefs: [
                     {
                         targets: 3, orderable: false,render:function(d)
                         {
                                     return `
                                         <button
                                             onclick="window.location.href='/Admin/BlogPost/Update/${d}'"
                                             type="button"
                                             class="btn btn-info btn-sm"
                                             title="Edit data">
                                             <i class="bx bx-edit"></i>
                                         </button>

                                         <button
                                             onclick="deleteBlog('${d}')"
                                             type="button"
                                             data-bs-toggle="offcanvas"
                                             data-bs-target="#offcanvasTop"
                                             aria-controls="offcanvasTop"
                                             class="btn btn-danger btn-sm"
                                             title="Delete data">
                                             <i class="bx bx-trash-alt"></i>
                                         </button>
                                         `;
                         }
                     },

                     {
                         targets: 1, orderable: false, render: function (data, type, row) {
                                return `
                                    <span class="badge bg-info btn-preview" data-content="${data}" style="cursor: pointer;">
                                        <i class="bx bx-book-open"></i>
                                    </span>
                                `;
                         }
                     }
                 ]
             });
         });


         function deleteBlog(d){
             $("#alert-message").html("Are you sure you want to delete this post? This action is <strong>permanent</strong> and cannot be undone!");
             $("#delete-id").val(d);
             $('#delete-form').attr('action', '/admin/blogpost/delete');
         }

        $('#delete-button-submit-button').click(function(){
            $('#delete-form').submit();
        });


         $('#blogPosts').on('click', '.btn-preview', function() {
            let content = $(this).data('content');
            preview(content);
        });


        function preview(data){
            const parsed = edjsHTML().parse(data);
            $('#blog-data').html(parsed);
            $('#blog-preview-modal').modal('show');
        }

        $('#search').click(function(e){
            e.preventDefault();
            $('#blogPosts').DataTable().ajax.reload();
        });
    </script>
}