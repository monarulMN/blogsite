@{
    ViewData["Title"] = "Cagetory list";
}
@section Style {
    <link rel="stylesheet" href="https://cdn.datatables.net/2.3.5/css/dataTables.dataTables.css" />
}

<h5 class="fw-bold py-3 mb-4"><span class="text-muted fw-light">Category /</span> Category list view</h5>

<div class="row">
    <div class="card">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div class="card-title mb-1">
                <h5>List view</h5>
            </div>
        </div>
        <div class="card-body">
            <partial name="_ResponsePartial" />
            <div class="table-responsive text-nowrap">
                <table class="table table-striped table-sm" id="categories">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Blog Site</th>
                            <th>Created At</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody class="table-border-bottom-0"></tbody>
                    <tfoot>
                        <tr>
                            <th>Name</th>
                            <th>Blog Site</th>
                            <th>Created At</th>
                            <th>Action</th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>

<partial name="_DeleteCanvasPartial" />

@section Scripts {
    <script src="https://cdn.datatables.net/2.3.5/js/dataTables.js"></script>
    <script>
         $(function(){
             $("#categories").DataTable({
                 processing: true,
                 serverSide: true,
                 responsive: true,
                 lengthChange: true,
                 autoWidth: false,
                 ajax:{
                     url:'/Admin/Category/GetCategoryData',
                     type:'post',
                     contentType:'application/json',
                     dataType:'json',
                     data: function(d){
                         d.searchItem = {

                         };

                         return JSON.stringify(d);
                     }
                 },
                 columnDefs: [
                     {
                         targets: 3, orderable: false,render:function(d)
                         {
                                     return `
                                         <button
                                             onclick="window.location.href='/Admin/Category/Update/${d}'"
                                             type="button"
                                             class="btn btn-info btn-sm"
                                             title="Edit data">
                                             <i class="bx bx-edit"></i>
                                         </button>

                                         <button
                                             onclick="deleteCategory('${d}')"
                                             type="button"
                                             data-bs-toggle="offcanvas"
                                             data-bs-target="#offcanvasTop"
                                             aria-controls="offcanvasTop"
                                             class="btn btn-danger btn-sm"
                                             title="Delete data">
                                             <i class="bx bx-trash-alt"></i>
                                         </button>
                                         `;
                         },
                     },
                     {targets: 1, orderable: false},
                     {targets: 2, orderable: false}
                 ]
             });
         });


         function deleteCategory(d){
             $("#alert-message").html("Are you sure you want to delete this category? This action is <strong>permanent</strong> and cannot be undone!");
             $("#delete-id").val(d);
             $('#delete-form').attr('action', '/admin/category/delete');
         }

        $('#delete-button-submit-button').click(function(){
            $('#delete-form').submit();
        });
    </script>
}