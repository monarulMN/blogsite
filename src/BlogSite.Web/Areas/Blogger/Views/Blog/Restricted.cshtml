<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Restricted Access</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body, html {
            height: 100%;
            background: linear-gradient(135deg, #6f42c1, #0d6efd);
            color: #fff;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .restricted-container {
            height: 100%;
            display: flex;
            justify-content: center;
            align-items: center;
            text-align: center;
            flex-direction: column;
            padding: 20px;
        }

        .restricted-icon {
            font-size: 6rem;
            animation: bounce 1.5s infinite;
            margin-bottom: 30px;
        }

        @@keyframes bounce {
            0%, 100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-20px);
            }
        }

        .restricted-card {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            border-radius: 15px;
            padding: 40px 30px;
            max-width: 450px;
            box-shadow: 0 8px 25px rgba(0,0,0,0.3);
        }

            .restricted-card h1 {
                font-size: 2rem;
                margin-bottom: 15px;
                font-weight: 700;
            }

            .restricted-card p {
                font-size: 1.1rem;
                margin-bottom: 25px;
            }

        .btn-contact {
            background: #ffc107;
            color: #000;
            font-weight: 600;
            transition: 0.3s;
        }

            .btn-contact:hover {
                background: #e0a800;
                color: #fff;
            }

        .footer-text {
            margin-top: 30px;
            font-size: 0.9rem;
            color: rgba(255,255,255,0.7);
        }
    </style>
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
</head>
<body>

    <div class="restricted-container">
        <div class="restricted-card">
            <i class="bi bi-shield-lock restricted-icon"></i>
            <h1>Access Restricted</h1>
            <p>This site or page is restricted.<br>Please contact the administrator to get access.</p>
            <a href="mailto:admin@example.com" class="btn btn-contact btn-lg">
                <i class="bi bi-envelope-fill"></i> Contact Admin
            </a>
        </div>
        <div class="footer-text">
            © 2026 Your Company. All rights reserved.
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>