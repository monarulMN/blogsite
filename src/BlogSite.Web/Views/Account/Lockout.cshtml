@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Access Blocked</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
          background-color: #f8f9fa;
          height: 100vh;
          display: flex;
          align-items: center;
          justify-content: center;
          text-align: center;
        }
        .block-card {
          padding: 40px;
          background: #fff;
          border-radius: 12px;
          box-shadow: 0 8px 24px rgba(0,0,0,0.1);
          max-width: 400px;
        }
        .block-icon {
          font-size: 50px;
          color: #dc3545;
        }
    </style>
</head>
<body>

    <div class="block-card">
        <div class="block-icon mb-3">
            &#128683; <!-- 🚫 icon -->
        </div>
        <h2 class="mb-3">Access Blocked</h2>
        <p class="mb-4">Your account has been blocked due to a violation of our rules.</p>
        <p>Please review our <a href="/privacy-policy" class="link-primary">Privacy Policy</a> and <a href="/terms-of-service" class="link-primary">Terms of Service</a>.</p>
        <a href="/" class="btn btn-primary mt-3">Go to Homepage</a>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
