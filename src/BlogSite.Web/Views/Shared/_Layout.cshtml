<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - ShareThought</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        :root {
            --primary-green: #790666;
            --light-bg: #fafaf8;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            background-color: var(--light-bg);
        }

        .navbar {
            background-color: #ffffff;
            border-bottom: 1px solid #000;
            padding: 1rem 0;
        }

        .navbar-brand {
            font-family: Georgia, 'Times New Roman', serif;
            font-size: 1.8rem;
            font-weight: 400;
            color: #000 !important;
        }

        .nav-link {
            color: #000 !important;
            margin: 0 1rem;
            font-size: 0.95rem;
        }

        .btn-get-started {
            background-color: #000;
            color: #fff;
            border-radius: 2rem;
            padding: 0.5rem 1.5rem;
            border: none;
            font-size: 0.95rem;
        }

            .btn-get-started:hover {
                background-color: #333;
            }

        .hero-section {
            background-color: var(--light-bg);
            min-height: 70vh;
            display: flex;
            align-items: center;
            position: relative;
            overflow: hidden;
        }

        .hero-content h1 {
            font-family: Georgia, 'Times New Roman', serif;
            font-size: 6.5rem;
            font-weight: 400;
            line-height: 1.1;
            margin-bottom: 2rem;
            letter-spacing: -0.05em;
        }

        .hero-content p {
            font-size: 1.5rem;
            color: #333;
            margin-bottom: 3rem;
        }

        .btn-start-reading {
            background-color: #000;
            color: #fff;
            border-radius: 2rem;
            padding: 0.75rem 3rem;
            border: none;
            font-size: 1.25rem;
            transition: all 0.3s ease;
        }

            .btn-start-reading:hover {
                background-color: #333;
                transform: translateY(-2px);
            }

        .hero-illustration {
            position: relative;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .illustration-container {
            position: relative;
            width: 100%;
            height: 500px;
        }

        /* Green flower/clover illustration */
        .green-flower {
            position: absolute;
            top: 30%;
            right: 20%;
            width: 200px;
            height: 200px;
        }

        .petal {
            position: absolute;
            width: 100px;
            height: 100px;
            background-color: var(--primary-green);
            border-radius: 50%;
            opacity: 0.9;
        }

            .petal:nth-child(1) {
                top: -40px;
                left: 50px;
            }

            .petal:nth-child(2) {
                top: 50px;
                right: -40px;
            }

            .petal:nth-child(3) {
                bottom: -40px;
                left: 50px;
            }

            .petal:nth-child(4) {
                top: 50px;
                left: -40px;
            }

        .petal-center {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 60px;
            height: 60px;
            background-color: #fff;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .petal-center::after {
                content: '✓';
                color: var(--primary-green);
                font-size: 2rem;
                font-weight: bold;
            }

        /* Green hand illustration */
        .green-hand {
            position: absolute;
            bottom: 2px;
            right: 5%;
            width: 400px;
            height: 300px;
            background-color: var(--primary-green);
            border-radius: 20px 20px 0 0;
            clip-path: polygon(0 20%, 15% 0, 30% 5%, 45% 0, 60% 10%, 75% 5%, 90% 15%, 100% 30%, 100% 100%, 0 100%);
        }

        /* Decorative elements */
        .star {
            position: absolute;
            color: #000;
            font-size: 1.5rem;
            animation: twinkle 2s infinite;
        }

        @@keyframes twinkle {
            0%, 100% {
                opacity: 0.3;
            }

            50% {
                opacity: 1;
            }
        }

        .star:nth-child(1) {
            top: 30%;
            right: 15%;
            animation-delay: 0s;
        }

        .star:nth-child(2) {
            top: 50%;
            right: 25%;
            animation-delay: 0.5s;
        }

        .star:nth-child(3) {
            bottom: 30%;
            right: 35%;
            animation-delay: 1s;
        }

        .star:nth-child(4) {
            bottom: 45%;
            right: 18%;
            animation-delay: 1.5s;
        }

        footer {
            background-color: var(--light-bg);
            border-top: 1px solid #ddd;
            padding: 2rem 0;
            margin-top: 3rem;
        }

            footer a {
                color: #666;
                text-decoration: none;
                margin: 0 1rem;
                font-size: 0.9rem;
            }

                footer a:hover {
                    color: #000;
                }

        @@media (max-width: 992px) {
            .hero-content h1 {
                font-size: 4rem;
            }

            .hero-illustration {
                display: none;
            }
        }

        @@media (max-width: 768px) {
            .hero-content h1 {
                font-size: 3rem;
            }

            .hero-content p {
                font-size: 1.2rem;
            }
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- Navigation -->
    <partial name="_NavbarPartial" />

    <!-- Hero Section -->
    <section class="hero-section">
        <div class="container">
            @RenderBody()
        </div>
    </section>

    <!-- Footer -->
    <partial name="_FooterPartial" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
